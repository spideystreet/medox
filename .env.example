# OpenRouter key used by the chat server. Visitors do not bring their own.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="mistralai/ministral-8b-2512"
# Embeddings (local — HuggingFace model name)
EMBEDDING_MODEL="intfloat/multilingual-e5-base"

# PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Dagster (must be absolute path)
DAGSTER_HOME="/absolute/path/to/medox/.dagster"

# SSL — custom CA bundle for French gov sites (Certigna Services CA)
# Build with: scripts/build_ca_bundle.sh  (or see README)
SSL_CERT_FILE="/absolute/path/to/medox/certs/ca-bundle.pem"

# LangSmith (optional — agent observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="medox"
